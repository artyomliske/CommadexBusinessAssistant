# HTTPS для панели и вебхуков.
#
# Caddy сам получает сертификат Let's Encrypt и сам его продлевает.
# Это не украшение: MAX с 25.05.2026 принимает вебхук только по HTTPS
# с сертификатом доверенного УЦ — самоподписанный он отвергает, и до
# домена система вообще не получает сообщений.
#
# Домен берётся из PUBLIC_DOMAIN (см. docker-compose.yml). Держать его
# здесь строкой значило бы править конфиг ради переезда.
{
	# Заявок на сертификат немного, но при отладке легко упереться в
	# ограничение Let's Encrypt на неделю. Тогда раскомментируйте
	# тестовый центр — сертификат будет недоверенным, зато без лимита.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	admin off
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Приложение адрес клиента нигде не читает, а все его перенаправления
	# относительные — поэтому ни X-Forwarded-*, ни uvicorn --proxy-headers
	# ему не нужны. Кто откуда приходил, видно в журнале ниже.
	reverse_proxy api:8000

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
