# Боевая конфигурация (российский сервер).
#
# Скопируйте в /opt/repairbot/.env и заполните. Секреты вводите здесь,
# на сервере, — не пересылайте их через мессенджеры.
#
#   chmod 600 .env
#
# Всё, что помечено ЗАПОЛНИТЬ, обязательно. Остальное можно оставить.

ENV=prod
LOG_LEVEL=INFO

# ЗАПОЛНИТЬ: домен, направленный на этот сервер. Вебхуки MAX и Telegram
# принимаются только по HTTPS с сертификатом доверенного УЦ.
#
# Домена ещё нет? Впишите http://IP-сервера:8000 И ОБЯЗАТЕЛЬНО поставьте
# ниже WEB_SESSION_HTTPS_ONLY=false. Иначе cookie сессии помечается Secure,
# по http не сохраняется, и вход будет бесконечно возвращать на форму —
# без единой ошибки в логах.
PUBLIC_BASE_URL=https://bot.вашдомен.ру

# Тот же домен без схемы — его берёт Caddy, чтобы получить сертификат.
# Заполняется автоматически из PUBLIC_BASE_URL (deploy/configure.sh).
PUBLIC_DOMAIN=

# Включает Caddy с HTTPS. Пусто — приложение слушает только петлю и
# снаружи недоступно: до появления домена это и нужно.
COMPOSE_PROFILES=

# --- Выход наружу ---
# ЗАПОЛНИТЬ: адрес и пароль прокси на зарубежном сервере.
# NO_PROXY оставьте как есть: MAX должен идти напрямую, а не через
# заграницу — это самое нагруженное направление.
HTTPS_PROXY=http://repairbot:ПАРОЛЬ@IP_ГЕРМАНИИ:3128
HTTP_PROXY=http://repairbot:ПАРОЛЬ@IP_ГЕРМАНИИ:3128
# Всё, что касается MAX, идёт напрямую: он и доступен только из России,
# и это самое нагруженное направление. Файлы вложений платформа раздаёт
# с отдельных доменов (fd.oneme.ru и другие в зоне oneme.ru) — без них
# в списке скачивание уходило за границу и упиралось в список
# разрешённых узлов прокси, отвечавший 403.
NO_PROXY=platform-api2.max.ru,.max.ru,max.ru,.oneme.ru,oneme.ru,localhost,127.0.0.1,postgres,redis

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=repairbot
POSTGRES_USER=repairbot
# ЗАПОЛНИТЬ: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

REDIS_URL=redis://redis:6379/0

# --- Канал MAX ---
# ЗАПОЛНИТЬ после модерации бота: кабинет организации → Расширенные
# настройки → Чат-бот → Токен доступа.
MAX_ACCESS_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# ЗАПОЛНИТЬ: произвольная длинная строка, попадает в путь URL вебхука.
MAX_WEBHOOK_SECRET=
MAX_RATE_LIMIT_RPS=30

# --- Канал Telegram ---
# Пусто — канал не подключается. Заполните, когда дойдёт очередь.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Языковые модели: OpenRouter ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
# ЗАПОЛНИТЬ: ключ OpenRouter для потока сообщений.
LLM_API_KEY=
# ЗАПОЛНИТЬ: точный идентификатор из списка моделей OpenRouter.
# На поток берём Sonnet: задача простая, а сообщений полторы тысячи в сутки.
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_SUPPORTS_MEDIA=true

# Документы читаются в два прохода. Сначала дешёвая модель: фотоотчётов
# больше половины, и платить за них как за чтение счёта незачем.
RECOGNIZE_FAST_MODEL=anthropic/claude-sonnet-4.5
# Дорогая перечитывает только финансовые документы, в которых дешёвая не
# уверена: неверная сумма попадает в бюджет объекта, и шесть центов на
# перечитывание дешевле разбирательств.
RECOGNIZE_MODEL=anthropic/claude-opus-4.1

# Резервный российский провайдер. Пусто — не подключается.
LLM_RESERVE_API_KEY=
LLM_RESERVE_MODEL=
LLM_RESERVE_BASE_URL=

# Ставки для оценки расхода на странице «Расход». Возьмите с OpenRouter
# для выбранной модели, иначе цифры будут неверными.
LLM_PRICE_INPUT_USD=3.0
LLM_PRICE_CACHED_INPUT_USD=0.3
LLM_PRICE_OUTPUT_USD=15.0
USD_RUB_RATE=95.0

# --- Веб-интерфейс ---
# ЗАПОЛНИТЬ: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Без него сессии не переживают перезапуск. В prod пустой = отказ при старте.
WEB_SESSION_SECRET=
# true — только когда панель открывается по https. См. PUBLIC_BASE_URL выше.
WEB_SESSION_HTTPS_ONLY=true

# --- Google ---
# Заполняется после разовой авторизации (см. README «Подключение Google»).
GOOGLE_OAUTH_CLIENT_SECRETS_PATH=secrets/google_client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=secrets/google_token.json
# ЗАПОЛНИТЬ: идентификатор папки на Диске заказчика.
GOOGLE_DRIVE_FOLDER_ID=
SHEETS_ROLLUP_SPREADSHEET_ID=

# --- Расход на модель ---
# Дороже этой суммы в долларах — система спросит подтверждение, прежде
# чем запускать разовую операцию (например, перечитать всю переписку).
SPEND_CONFIRM_USD=1.0
# Потрачено за сутки больше этой суммы — предупреждение в чат MAX.
SPEND_ALERT_USD=5.0

# --- Внутренний помощник ---
# Кому бот отвечает в личном диалоге как помощник: идентификаторы через
# запятую. ПУСТО — помощник выключен, и это верно по умолчанию.
#
# Помощник видит деньги, сроки и всю картину компании. Проверка идёт по
# идентификатору учётной записи, а не по имени: имя подделывается.
# Свой идентификатор покажет команда `listen`.
ASSISTANT_USER_IDS=

# --- Сводки и напоминания ---
# ЗАПОЛНИТЬ после первого запуска: repairbot listen --seconds 60
MANAGER_CHAT_ID=
# 6 UTC = 9 утра в Москве, до начала рабочего дня на объектах.
DIGEST_HOUR_UTC=6

SENTRY_DSN=
