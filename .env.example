# Development-only template. Never commit a populated .env file.
ENV=dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:6379/0

# External channels are disabled when credentials are empty.
MAX_ACCESS_TOKEN=
MAX_WEBHOOK_SECRET=change-me-in-dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-in-dev

# LLM provider. Keep credentials outside Git.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_SUPPORTS_MEDIA=false
LLM_EFFORT=low
LLM_RESERVE_API_KEY=
LLM_RESERVE_MODEL=
LLM_RESERVE_BASE_URL=
LLM_COOLDOWN_SECONDS=60

# Operations panel.
WEB_SESSION_SECRET=
WEB_SESSION_MAX_AGE_SECONDS=43200
WEB_SESSION_HTTPS_ONLY=false

# Optional cloud adapters; leave empty for the demo.
GOOGLE_OAUTH_CLIENT_SECRETS_PATH=
GOOGLE_OAUTH_TOKEN_PATH=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_IMPERSONATE_SUBJECT=
SHEETS_ROLLUP_SPREADSHEET_ID=
MANAGER_CHAT_ID=

LOG_LEVEL=INFO
SENTRY_DSN=
